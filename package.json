{
  "name": "xbox-vgamepad",
  "private": true,
  "version": "0.0.977",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && rm -rf dist && vite build",
    "ts:check": "tsc -b --noEmit",
    "lint": "eslint . --fix",
    "pretty": "prettier --write .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration",
    "test:integration": "vite build --mode test && node test/gamepad.test.cjs",
    "test:unit": "tsx --tsconfig tsconfig.test.json --import ./test/unit/setup.mjs --test 'test/unit/*.test.ts'",
    "test:patch": "vite build --mode test && node test/patch/run.cjs",
    "test:patch:setup": "vite build --mode test && node test/patch/setup.cjs",
    "test:extract": "vite build --mode test && node test/extract/extract.test.cjs",
    "test:extract:early": "vite build --mode test && node test/extract/run-span.cjs early 5",
    "test:extract:quarter": "vite build --mode test && node test/extract/run-span.cjs quarter 120",
    "test:extract:mid": "vite build --mode test && node test/extract/run-span.cjs mid 300",
    "test:extract:3quarter": "vite build --mode test && node test/extract/run-span.cjs 3quarter 600",
    "test:extract:late": "vite build --mode test && node test/extract/run-span.cjs late 900",
    "test:extract:full": "vite build --mode test && node test/extract/extract-full.test.cjs",
    "test:extract:mega": "vite build --mode test && node test/extract/extract-mega.test.cjs",
    "test:extract:smoke": "node test/extract/extract-smoke.test.cjs",
    "test:extract:smoke-extension": "vite build --mode test && node test/extract/extract-smoke-extension.test.cjs",
    "test:extract:setup": "vite build --mode test && node test/extract/extract-setup.cjs",
    "test:extract:smoke:setup": "vite build --mode test && node test/extract/extract-smoke-setup.cjs"
  },
  "dependencies": {
    "aphrodite": "^2.4.0",
    "events": "^3.3.0",
    "ioctl": "^2.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "https://github.com/jim-lake/chrome-extension-tools.git#4f7f9a8c973cb35cf663b76f9d1dfffd3f1fd8e6",
    "@eslint/js": "9.x",
    "@types/chrome": "^0.1.40",
    "@types/dom-chromium-ai": "^0.0.16",
    "@types/events": "^3.0.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "9.x",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "puppeteer": "^24.43.0",
    "puppeteer-core": "^24.43.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
