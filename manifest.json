{
  "manifest_version": 3,
  "name": "Xbox vGamepad",
  "version": "0.0.85",
  "description": "Play Xbox Cloud Gaming with keyboard and mouse",
  "action": { "default_popup": "src/popup/index.html" },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*"
      ],
      "js": ["src/injected/main-world.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": ["storage", "tabs"],
  "web_accessible_resources": [
    {
      "resources": ["src/assets/img/*"],
      "matches": [
        "*://*.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*"
      ]
    }
  ],
  "icons": {
    "16": "src/assets/img/icon16.png",
    "48": "src/assets/img/icon48.png",
    "128": "src/assets/img/icon128.png"
  }
}
