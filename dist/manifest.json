{
  "manifest_version": 3,
  "name": "Xbox vGamepad",
  "version": "0.0.1239",
  "description": "Play Xbox Cloud Gaming with keyboard and mouse",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-BKSBbEq4.js"
      ],
      "matches": [
        "https://xbox.com/*",
        "https://www.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*",
        "https://harbour.lol/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/main-world.js"
      ],
      "matches": [
        "https://xbox.com/*",
        "https://www.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*",
        "https://harbour.lol/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://gamepad-tester.com/*",
        "https://harbour.lol/*",
        "https://hardwaretester.com/*",
        "https://www.xbox.com/*",
        "https://xbox.com/*"
      ],
      "resources": [
        "src/assets/img/*",
        "assets/log-Bfgay_I2.js",
        "assets/log-Bfgay_I2.js.map",
        "assets/array_b64-SW65bjv2.js",
        "assets/array_b64-SW65bjv2.js.map",
        "assets/gamepad-BEzrPwoZ.js",
        "assets/gamepad-BEzrPwoZ.js.map",
        "assets/index.ts-CyV3Son4.js",
        "assets/index.ts-CyV3Son4.js.map",
        "assets/main-world.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "src/assets/img/icon16.png",
    "48": "src/assets/img/icon48.png",
    "128": "src/assets/img/icon128.png"
  }
}
