{
  "manifest_version": 3,
  "name": "Xbox Virtual Gamepad",
  "version": "0.0.39",
  "description": "Play Xbox Cloud Gaming with keyboard and mouse",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-DfHdye3t.js"
      ],
      "matches": [
        "*://*.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*",
        "http://localhost:9332/*",
        "http://localhost:9333/*",
        "http://localhost:5173/*",
        "http://127.0.0.1/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/main-world.ts-loader-DnEi2R3N.js"
      ],
      "matches": [
        "*://*.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*",
        "http://localhost:9332/*",
        "http://localhost:9333/*",
        "http://localhost:5173/*",
        "http://127.0.0.1/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.xbox.com/*",
        "http://127.0.0.1/*",
        "http://localhost:5173/*",
        "http://localhost:9332/*",
        "http://localhost:9333/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*"
      ],
      "resources": [
        "src/assets/img/*",
        "assets/messages-BV0uK2F9.js",
        "assets/messages-BV0uK2F9.js.map",
        "assets/index.ts-DMr_E3vO.js",
        "assets/index.ts-DMr_E3vO.js.map",
        "assets/gamepad-zjigURwv.js",
        "assets/gamepad-zjigURwv.js.map",
        "assets/main-world.ts-_PvqOcHd.js",
        "assets/main-world.ts-_PvqOcHd.js.map"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "src/assets/img/icon16.png",
    "48": "src/assets/img/icon48.png",
    "128": "src/assets/img/icon128.png"
  }
}
