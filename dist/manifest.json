{
  "manifest_version": 3,
  "name": "Xbox vGamepad",
  "version": "0.0.135",
  "description": "Play Xbox Cloud Gaming with keyboard and mouse",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-DxFIbOgq.js"
      ],
      "matches": [
        "*://*.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/main-world.ts-loader-DzVAXu55.js"
      ],
      "matches": [
        "*://*.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*"
      ],
      "resources": [
        "src/assets/img/*",
        "assets/messages-BV0uK2F9.js",
        "assets/messages-BV0uK2F9.js.map",
        "assets/index.ts-BToX-LN_.js",
        "assets/index.ts-BToX-LN_.js.map",
        "assets/gamepad-CDk-qNbI.js",
        "assets/gamepad-CDk-qNbI.js.map",
        "assets/main-world.ts-qodLD6x8.js",
        "assets/main-world.ts-qodLD6x8.js.map"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "src/assets/img/icon16.png",
    "48": "src/assets/img/icon48.png",
    "128": "src/assets/img/icon128.png"
  }
}
