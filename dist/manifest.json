{
  "manifest_version": 3,
  "name": "Xbox vGamepad",
  "version": "0.0.514",
  "description": "Play Xbox Cloud Gaming with keyboard and mouse",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-DDte_RMw.js"
      ],
      "matches": [
        "https://xbox.com/*",
        "https://www.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/main-world.js"
      ],
      "matches": [
        "https://xbox.com/*",
        "https://www.xbox.com/*",
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://gamepad-tester.com/*",
        "https://hardwaretester.com/*",
        "https://www.xbox.com/*",
        "https://xbox.com/*"
      ],
      "resources": [
        "src/assets/img/*",
        "assets/log-CdX914LT.js",
        "assets/log-CdX914LT.js.map",
        "assets/gamepad-G4Xl1Wcx.js",
        "assets/gamepad-G4Xl1Wcx.js.map",
        "assets/index.ts-BzJZHMlJ.js",
        "assets/index.ts-BzJZHMlJ.js.map",
        "assets/main-world.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "src/assets/img/icon16.png",
    "48": "src/assets/img/icon48.png",
    "128": "src/assets/img/icon128.png"
  }
}
